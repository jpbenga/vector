{
  "buildCommand": "bash tool/build_web_staging.sh",
  "outputDirectory": "build/web",
  "installCommand": "true",
  "crons": [
    {
      "path": "/api/daily-football-sync",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
